# Environment for `pnpm test:integration`. Committed on purpose: it holds no real secret.
# It points at the hookdeck_test database and Redis index 1, so development data is never touched.
# Variables already set in the environment (for example in CI) take precedence over this file.
# See docs/TESTING.md#getting-postgres-and-redis

NODE_ENV=test
LOG_LEVEL=silent

DATABASE_URL=postgresql://hookdeck:hookdeck@localhost:5432/hookdeck_test
REDIS_URL=redis://localhost:6379/1
# Each test file appends its own random suffix to this prefix.
BULLMQ_PREFIX=hdl-test

# Test-only key: base64 of the 32 ASCII bytes "hookdeck-lite-test-master-key-00".
SECRETS_MASTER_KEY=aG9va2RlY2stbGl0ZS10ZXN0LW1hc3Rlci1rZXktMDA=

SSRF_ALLOWLIST=127.0.0.1,localhost

# Integration backoff profile (docs/QUEUES.md#worked-delay-table): retries take milliseconds.
BACKOFF_BASE_MS=20
BACKOFF_CAP_MS=200
DELIVERY_MAX_ATTEMPTS=4
