{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NestJS dependency injection reads constructor parameter types at runtime.
    // These two options make the compiler emit that metadata (docs/adr/0017-toolchain-versions.md).
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true
  },
  "include": ["src", "test", "vitest.config.ts", "vitest.integration.config.ts"]
}
