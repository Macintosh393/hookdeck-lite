# Local development configuration. Create your own copy with:  pnpm setup:env
# That command copies this file to .env and fills in SECRETS_MASTER_KEY with a fresh random key.
# Every variable is documented in docs/ARCHITECTURE.md#configuration. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# --- api ---
PORT=3001
CORS_ORIGINS=http://localhost:3000
SIGNATURE_TOLERANCE_SECONDS=300
INGEST_MAX_BODY_BYTES=1048576

# --- data stores (docker compose up -d) ---
DATABASE_URL=postgresql://hookdeck:hookdeck@localhost:5432/hookdeck
REDIS_URL=redis://localhost:6379/0
BULLMQ_PREFIX=hdl

# --- secrets ---
# Base64 of exactly 32 random bytes. Encrypts source and destination secrets at rest.
# `pnpm setup:env` generates one. By hand:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_MASTER_KEY=

# Hostnames that skip the SSRF IP-range check. Needed locally so deliveries can reach the
# mock receiver on localhost. MUST be empty in production.
SSRF_ALLOWLIST=localhost,127.0.0.1,mock-receiver

# --- delivery (worker) ---
DELIVERY_MAX_ATTEMPTS=10
BACKOFF_BASE_MS=30000
BACKOFF_CAP_MS=3600000
DELIVERY_TIMEOUT_MS=15000
DELIVERY_MAX_RESPONSE_BYTES=16384
DELIVERY_CONCURRENCY=50
FANOUT_CONCURRENCY=10
SWEEPER_INTERVAL_MS=15000
SWEEPER_STUCK_AFTER_MS=30000

# --- seed and tools ---
# API key the seed creates for the demo tenant. Format: hdl_<8 chars>_<32 chars>, letters and digits.
# This value is a local development default, not a secret. Use your own anywhere else.
SEED_API_KEY=hdl_demo1234_devkeydevkeydevkeydevkeydevkey00
MOCK_RECEIVER_PORT=4000

# --- web (Day 3) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
